# Set these as GitHub Codespaces secrets (repo/org Settings > Secrets and
# variables > Codespaces), not in a committed .env file.
API_ID=
API_HASH=
BOT_TOKEN=
EVERYONE_CHATS=
ADMIN_CHATS=
STARTUP_CHANNEL=

# MongoDB Atlas connection string (free tier works) - Codespaces has no
# local mongod, so this must point to an external cluster.
MONGO_URI=

# NOT needed as a secret: run.sh auto-generates a random ARIA2_SECRET
# and starts the aria2c RPC daemon itself on container start.
