# Set these as GitHub Codespaces secrets (repo/org Settings > Secrets and
# variables > Codespaces), not in a committed .env file.
API_ID=
API_HASH=
BOT_TOKEN=

# Space-separated numeric Telegram user IDs allowed to use the bot
# (also grants access to admin-only commands like /exec).
# Get your ID by DMing @userinfobot on Telegram.
AUTHORIZED_CHATS=

# MongoDB Atlas connection string (free tier works) - Codespaces has no
# local mongod, so this must point to an external cluster.
MONGO_URI=

# NOT needed as a secret: run.sh / bot.py auto-generate a random
# ARIA2_SECRET and start the aria2c RPC daemon themselves on launch.
